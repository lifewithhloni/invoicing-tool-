# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — public values (safe in the browser; access is enforced by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server only. Never prefix with NEXT_PUBLIC_ or import into client components.
SUPABASE_SECRET_KEY=

# Anthropic API for slip extraction (Phase 4) — server only.
ANTHROPIC_API_KEY=
